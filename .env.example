# 32 octets en hex : openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Secret partagé avec Supabase Vault (cron_secret) : openssl rand -hex 24
CRON_SECRET=

# Web Push : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Comptes Google autorisés (séparés par des virgules)
